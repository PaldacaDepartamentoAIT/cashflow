# Copiar a .env y completar antes de `docker compose up`.
# Nunca subir .env al repositorio.

# --- Django ---
DJANGO_ENV=production
DEBUG=0
SECRET_KEY=cambiar-por-una-clave-larga-aleatoria
ALLOWED_HOSTS=tu-dominio.com,www.tu-dominio.com
CSRF_TRUSTED_ORIGINS=https://tu-dominio.com,https://www.tu-dominio.com

# Dominio público (Caddy + Let's Encrypt). En pruebas locales: localhost
DOMAIN=tu-dominio.com

# HTTPS: 1 cuando el dominio ya apunta al VPS y Caddy emite certificado
SECURE_SSL_REDIRECT=1
SESSION_COOKIE_SECURE=1
CSRF_COOKIE_SECURE=1
SECURE_HSTS_SECONDS=31536000

# --- MySQL (Compose interno) ---
MYSQL_DATABASE=cashflow
MYSQL_USER=cashflow
MYSQL_PASSWORD=cambiar-por-password-fuerte
MYSQL_ROOT_PASSWORD=cambiar-por-password-root-fuerte

# La contraseña de DATABASE_URL debe coincidir con MYSQL_PASSWORD.
# Si el password tiene @ : / # ?, codifícalo en la URL (ej. @ → %40).
DATABASE_URL=mysql://cashflow:cambiar-por-password-fuerte@db:3306/cashflow
# MySQL externo en el VPS o managed:
# DATABASE_URL=mysql://usuario:password@IP_O_HOST:3306/cashflow

DB_CONN_MAX_AGE=60

# Gunicorn (opcional; el CMD del Dockerfile usa 3 workers)
# WEB_CONCURRENCY=3
