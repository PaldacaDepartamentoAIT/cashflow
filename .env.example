# Copiar a .env y completar antes de `docker compose up`.
# Nunca subir .env al repositorio.

# --- Django ---
DJANGO_ENV=production
DEBUG=0
SECRET_KEY=cambiar-por-una-clave-larga-aleatoria
ALLOWED_HOSTS=tu-dominio.com,www.tu-dominio.com
CSRF_TRUSTED_ORIGINS=https://tu-dominio.com,https://www.tu-dominio.com

# Dominio público (Caddy + Let's Encrypt). En pruebas locales: localhost
DOMAIN=tu-dominio.com

# HTTPS: 1 cuando el dominio ya apunta al VPS y Caddy emite certificado
SECURE_SSL_REDIRECT=1
SESSION_COOKIE_SECURE=1
CSRF_COOKIE_SECURE=1
SECURE_HSTS_SECONDS=31536000

# --- PostgreSQL (Compose interno) ---
POSTGRES_DB=cashflow
POSTGRES_USER=cashflow
POSTGRES_PASSWORD=cambiar-por-password-fuerte

# La contraseña de DATABASE_URL debe coincidir con POSTGRES_PASSWORD.
# Si el password tiene @ : / # ?, codifícalo en la URL (ej. @ → %40).
DATABASE_URL=postgres://cashflow:cambiar-por-password-fuerte@db:5432/cashflow
# Postgres externo en el VPS o managed:
# DATABASE_URL=postgres://usuario:password@IP_O_HOST:5432/cashflow?sslmode=prefer

DB_CONN_MAX_AGE=60
DB_SSLMODE=prefer

# Gunicorn (opcional; el CMD del Dockerfile usa 3 workers)
# WEB_CONCURRENCY=3
