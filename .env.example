# Copiar como .env (docker-compose local) o cargar como variables de entorno
# del recurso "Application" en Coolify. No commitear el .env real.

DJANGO_ENV=production
DEBUG=0
DJANGO_USE_SQLITE=0

# Clave larga y aleatoria: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=

# Dominios permitidos, separados por coma (sin http/https, sin barra final)
ALLOWED_HOSTS=cashflow.tudominio.com

# Orígenes CSRF, separados por coma (CON esquema https://)
CSRF_TRUSTED_ORIGINS=https://cashflow.tudominio.com

# Poner en 1 en Coolify (hay un proxy Traefik delante terminando TLS)
DJANGO_TRUST_PROXY_SSL_HEADER=1

# Base de datos (MariaDB 11.4, usa el mismo backend django.db.backends.mysql)
DB_NAME=cashflow_db
DB_USER=cashflow
DB_PASSWORD=
DB_HOST=db
DB_PORT=3306

# Solo para docker-compose local (contraseña root del contenedor mariadb)
DB_ROOT_PASSWORD=

# Fotos adjuntas de transacciones.
# DJANGO_MEDIA_ROOT DEBE apuntar a un volumen persistente (en Coolify, declararlo
# también en el panel "Persistent Storage" del recurso Application): de lo
# contrario las fotos se borran en cada despliegue.
DJANGO_MEDIA_ROOT=/app/media
TRANSACTION_PHOTOS_MAX=10
# Peso objetivo por foto ya comprimida, en bytes (40 KB).
TRANSACTION_PHOTO_TARGET_BYTES=40960
# Tamaño máximo aceptado en la subida, antes de recomprimir (15 MB).
TRANSACTION_PHOTO_MAX_UPLOAD_BYTES=15728640

# -----------------------------------------------------------------------------
# Correo saliente (recuperación de contraseña) — SMTP de MXroute
# -----------------------------------------------------------------------------
# No hace falta un proveedor tipo SendGrid/Mailgun: basta el buzón SMTP de MXroute.
# EMAIL_HOST_USER es la dirección completa, no solo el nombre del buzón.
# Si 587/STARTTLS da problemas: EMAIL_PORT=465 y EMAIL_USE_SSL=1 (el TLS se
# desactiva solo; Django no admite ambos a la vez).
# El dominio debe tener SPF y DKIM de MXroute publicados en DNS o el correo cae en spam.
EMAIL_HOST=xxx.mxrouting.net
EMAIL_PORT=587
EMAIL_USE_TLS=1
EMAIL_USE_SSL=0
EMAIL_HOST_USER=no-reply@tudominio.com
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=no-reply@tudominio.com

# Validez del enlace de restablecimiento, en segundos (por defecto 1 hora).
PASSWORD_RESET_TIMEOUT=3600
# Límite de solicitudes de restablecimiento por sesión dentro de la ventana.
PASSWORD_RESET_MAX_INTENTOS=5
PASSWORD_RESET_VENTANA_SEGUNDOS=3600

# Solo para desarrollo: forzar backend de consola en vez de SMTP.
# EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
